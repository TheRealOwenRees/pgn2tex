{
  "name": "@owenrees/pgn2tex",
  "version": "0.2.0",
  "description": "PGN to TeX converter",
  "author": "Owen Rees <owenrees@tutanota.com>",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "repository": {
    "url": "git+https://github.com/TheRealOwenRees/pgn2tex.git"
  },
  "keywords": [
    "chess",
    "pgn",
    "tex",
    "latex"
  ],
  "engines": {
    "node": "^20.15.0"
  },
  "scripts": {
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "lint": "eslint . --ext .ts",
    "lint:quiet": "eslint . --quiet",
    "lint:strict": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --ext .ts --fix",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "build": "tsc -p tsconfig.json",
    "check": "npm run prettier && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@mliebelt/pgn-parser": "^1.4.15"
  },
  "devDependencies": {
    "@types/jest": "^29.5.3",
    "@mliebelt/pgn-types": "^1.0.4",
    "@types/node": "^20.10.3",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.10.0",
    "eslint": "^9.39.2",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.5.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.4.4",
    "typescript": "^5.3.3"
  }
}
